APP_ENV=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/voice_ai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-realtime-2.1
VOICE_NAME=marin
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=["https://YOUR-FRONTEND-DOMAIN"]
MAX_REQUEST_BODY_MB=15
RATE_LIMIT_PER_MINUTE=60
SYSTEM_INSTRUCTIONS=أنت مساعد صوتي عربي طبيعي وسريع. تحدث بالعربية بوضوح واختصار. استخدم الأدوات عند الحاجة، ولا تخترع نتائجها. لا تنفذ عمليات مالية أو تغييرات حساسة دون طلب واضح وموافقة المستخدم. اسم المساعد: مساعد مروان.

MONE_API_URL=
MONE_API_TOKEN=
MONE_CUSTOMERS_PATH=/api/v1/customers
MONE_PROJECT_PATH=/api/v1/projects/{project_id}
MONE_PRICING_PATH=/api/v1/pricing/calculate
MONE_CUTLIST_PATH=/api/v1/cutlists
MONE_PIPELINE_PATH=/api/v1/pipeline/run

REDIS_URL=redis://redis:6379/0
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
REALTIME_SESSION_URL=https://api.openai.com/v1/realtime/sessions
ATTACHMENT_DIR=/tmp/voice-ai-attachments
TOOL_RATE_LIMIT_PER_MINUTE=30
ALLOWED_ORIGINS=